# Description: Book Recommendation System using Collaborative Filtering

import pandas as pd
import numpy as np
from sklearn.metrics.pairwise import cosine_similarity

book_data = {
'User': ['Arjun','Arjun','Arjun','Priya','Priya','Priya','Ravi','Ravi','Ravi','Sneha','Sneha','Sneha','Kiran','Kiran','Kiran'],
'Book': ['Alchemist','Ikigai','AtomicHabits','Alchemist','RichDadPoorDad','Ikigai','AtomicHabits','RichDadPoorDad','Wings','Ikigai','Wings','Alchemist','AtomicHabits','Wings','RichDadPoorDad'],
'Rating': [5,4,3,4,5,3,5,4,3,4,5,3,2,4,5]
}

df = pd.DataFrame(book_data)
print("=" * 45)
print("       BOOK RATINGS DATASET")
print("=" * 45)
print(df.to_string(index=False))

# Step 1: User-Book Matrix
print("\n--- Step 1: User-Book Rating Matrix ---")
matrix = df.pivot_table(index='User', columns='Book', values='Rating').fillna(0)
print(matrix)

# Step 2: Cosine Similarity
print("\n--- Step 2: User Similarity Scores ---")
sim = cosine_similarity(matrix)
sim_df = pd.DataFrame(sim, index=matrix.index, columns=matrix.index)
print(sim_df.round(2))

# Step 3: Weighted prediction
print("\n--- Step 3: Predicted Ratings ---")
target = 'Arjun'
already_read = matrix.loc[target][matrix.loc[target] > 0].index.tolist()
not_read = [b for b in matrix.columns if b not in already_read]

scores = {}
for book in not_read:
    total_sim = 0
    weighted_sum = 0
    for user in matrix.index:
        if user != target and matrix.loc[user, book] > 0:
            weight = sim_df.loc[target, user]
            weighted_sum += weight * matrix.loc[user, book]
            total_sim += abs(weight)
    if total_sim > 0:
        scores[book] = round(weighted_sum / total_sim, 2)
    else:
        scores[book] = 0

print("Predicted scores for unread books:")
for book, score in scores.items():
    print(book, ":", score)

# Step 4: Recommend
print("\n--- Step 4: Recommendations for", target, "---")
print("Already Read :", already_read)
print("Not Read Yet :", not_read)
recommended = sorted(scores.items(), key=lambda x: x[1], reverse=True)
print("\nTop Book Recommendations for", target)
for book, score in recommended:
    print(book, "-->", score, "stars (predicted)")

# Step 5: RMSE
print("\n--- Step 5: Model Evaluation ---")
actual = matrix.values
predicted = np.dot(sim_df.values, matrix.values)
pred_df = pd.DataFrame(predicted, index=matrix.index, columns=matrix.columns)
mask = actual > 0
rmse = np.sqrt(np.mean((actual[mask] - predicted[mask])**2))
print("RMSE Score :", round(rmse, 4))
print("(Lower RMSE = Better | Scale: 1-5 ratings)")
print("\n✅ Task 4 Complete - Book Recommendation System!")
